# =============================================================================
# AI SimTest API — Environment Configuration (Week 5)
# Copy to .env and fill in values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Storage backend selection
# -----------------------------------------------------------------------------
# Options: local | r2
# Default: local (recommended for dev/test, no credentials needed)
STORAGE_BACKEND=local

# -----------------------------------------------------------------------------
# Local filesystem storage (only used when STORAGE_BACKEND=local)
# -----------------------------------------------------------------------------
LOCAL_STORAGE_ROOT=/tmp/simtest-storage
LOCAL_STORAGE_BUCKET=simtest-local

# -----------------------------------------------------------------------------
# Cloudflare R2 storage (only used when STORAGE_BACKEND=r2)
# -----------------------------------------------------------------------------
# Get these from Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_BUCKET=ai-simtest-dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional — derived from R2_ACCOUNT_ID if unset:
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto

# -----------------------------------------------------------------------------
# Payload routing — when content goes inline vs object storage
# -----------------------------------------------------------------------------
# Default: 65536 (64 KB). Content larger than this goes to object storage.
PAYLOAD_R2_THRESHOLD_BYTES=65536

# -----------------------------------------------------------------------------
# Signed URL TTL
# -----------------------------------------------------------------------------
# Default: 900 seconds (15 minutes). Range: 60..3600.
SIGNED_URL_TTL_SECONDS=900
