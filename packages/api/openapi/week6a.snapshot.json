      "ComparisonRecord": {
        "description": "First-class comparison resource (v1.2.2 \u00a7M2 hybrid storage rule).\n\nInline fields are the SINGLE SOURCE OF TRUTH for both\nGET /v1/comparisons/{id} and GET /v1/comparisons/{id}/regression-signals.\n`result_ref` is reserved for Week 6b/7 heavy diff artifacts and is\nNone for all comparisons created in 6a.",
        "properties": {
          "comparison_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comparison Profile"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "engine_version": {
            "default": "engine_v1",
            "title": "Engine Version",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "evidence_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Count"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "left_provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunProvenance"
              },
              {
                "type": "null"
              }
            ]
          },
          "left_run_id": {
            "title": "Left Run Id",
            "type": "string"
          },
          "metric_deltas": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/MetricDelta"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metric Deltas"
          },
          "regression_signals": {
            "items": {
              "$ref": "#/components/schemas/RegressionSignal"
            },
            "title": "Regression Signals",
            "type": "array"
          },
          "result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Ref"
          },
          "right_provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunProvenance"
              },
              {
                "type": "null"
              }
            ]
          },
          "right_run_id": {
            "title": "Right Run Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/ComparisonStatus",
            "default": "pending"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "enum": [
                  "regression",
                  "improvement",
                  "neutral",
                  "inconclusive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "workspace_id": {
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "tenant_id",
          "left_run_id",
          "right_run_id"
        ],
        "title": "ComparisonRecord",
        "type": "object"
      },
      "ComparisonStatus": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed"
        ],
